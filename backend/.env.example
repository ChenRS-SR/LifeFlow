# 环境变量配置文件
# 复制此文件为 .env 并填入真实值

# 运行环境：development / production / test
ENVIRONMENT=development

# 数据库连接（PostgreSQL）
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://lifeflow_user:your_password@localhost:5432/lifeflow

# JWT 密钥（生产环境请使用强密码；未设置时开发环境会自动生成临时密钥）
SECRET_KEY=your-super-secret-key-change-this-in-production

# 是否允许开放注册；公网部署建议设为 false
ALLOW_REGISTRATION=true

# 调试模式（生产环境设为 False）
DEBUG=True

# AI 配置（用于图片识别、AI 复盘等）
# 支持 OpenAI / DeepSeek / Claude 等 OpenAI 兼容接口
AI_PROVIDER=openai
AI_API_KEY=sk-your-key-here
AI_MODEL=gpt-4o-mini
# AI_BASE_URL=https://api.openai.com/v1
# AI_MAX_TOKENS=1500
# AI_TEMPERATURE=0.2

# 训记 Open API 配置（用于训练记录同步）
# 申请与文档：https://xunjiapp.cn
XUNJI_API_KEY=xjllm-your-key-here
XUNJI_BASE_URL=https://trains.xunjiapp.cn
